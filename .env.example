# ========================================================
# Arth Properties — Environment Variables Configuration
# ========================================================

# Public Website URL (Used for Canonical URLs, OpenGraph, and Sitemap)
NEXT_PUBLIC_SITE_URL=https://arthproperties.in

# Supabase Free Tier Configuration (PostgreSQL Database + Auth + Storage)
# Obtain these from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Secret Key (Optional, for privileged backend cron or server operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fallback Master Administrator Credentials
# Note: When Supabase Auth is connected, create an admin user in Supabase Auth table.
# Until then, or as a fail-safe fallback, these credentials allow direct admin login:
ADMIN_FALLBACK_EMAIL=arthproperties@gmail.com
ADMIN_FALLBACK_PASSWORD=Arth@Pune2026!
